        <!-- N:TingenWebService.Trove -->
        <member name="N:TingenWebService.Trove">
            <summary>A collection of resources used by the Tingen Web Service.</summary>
            <remarks>
                The <b>Trove</b> is a collection templates, preset values, and other resources used by the Tingen Web Service to format data in a consistent manner.<br>
                </br>
                The Trove contains:
                <list type="bullet">
                    <item>
                        <term>
                            <b>
                                <see cref="Blueprint"/>
                            </b>
                        </term>
                        <description>User-modifiable templates (e.g., log files, error messages)</description>
                    </item>
                    <item>
                        <term>
                            <b>
                                <see cref="Catalog"/>
                            </b>
                        </term>
                        <description>Preset components (e.g, list of required directories)</description>
                    </item>
                    <item>
                        <term>
                            <b>
                                <see cref="Epistle"/>
                            </b>
                        </term>
                        <description>Preset messages (e.g., welcome messages, notifications)</description>
                    </item>
                    <item>
                        <see cref="Epistle"/> - Preset messages (e.g., welcome messages, notifications)
                    </item>
                </list>
            </remarks>
        </member>

