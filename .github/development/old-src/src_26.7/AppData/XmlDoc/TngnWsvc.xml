    <Class name="Definition">

        <!-- <include file='AppData/XmlDoc/TngnWsvc.xml' path='TngnWsvc/Class[@name="Definition"]/AvatarEnvironment/*'/> -->
        <AvatarEnvironment>
            <note type="information" title="About Avatar Environments">
                An <b>Avatar environment</b> consists of two components: the Avatar <i>System</i> and Avatar <i>System Code</i>.<br/>
                <br/>
                You can read more about Avatar Environments <see href="https://github.com/spectrum-health-systems/Tingen-WebService/blob/development/docs/appendix/AvatarEnvironment.md">here</see>.
            </note>
        </AvatarEnvironment>

        <!-- <include file='AppData/XmlDoc/TngnWsvc.xml' path='TngnWsvc/Class[@name="Definition"]/OptionObject/*'/> -->
        <OptionObject>
            <note type="information" title="About Avatar OptionObjects">
                An Avatar <see cref="OptionObject2015"/> defines the XML contract required for use with myAvatar ScriptLink.<br/>
                    <br/>
                    The Tingen Web Services uses three different OptionObjects:
                    <list type="bullet">
                        <item>
                        <see cref="Original"/>: The original OptionObject that is passed from myAvatar, and is never modified
                    </item>
                    <item>
                        <see cref="Worker"/>: The working copy of the OptionObject that is used for processing, and may be modified as needed
                    </item>
                    <item>
                        <see cref="Completed"/>: The completed OptionObject that is returned to myAvatar
                    </item>
                </list>
                You can read more about OptionObjects <see href="https://github.com/spectrum-health-systems/Tingen-WebService/blob/development/docs/appendix/OptionObject.md">here</see>.
            </note>
        </OptionObject>

        <!-- <include file='AppData/XmlDoc/TngnWsvc.xml' path='TngnWsvc/Class[@name="Definition"]/ScriptParameter/*'/> -->
        <ScriptParameter>
            <note type="information" title="About the Avatar ScriptParameter">
                The Avatar <see cref="ScriptParameter"/> tells the Tingen Web Service what action(s) to perform.<br/>
                <br/>
                You can read more about the Script Parameter <see href="https://github.com/spectrum-health-systems/Tingen-WebService/blob/development/docs/appendix/ScriptParameter.md">here</see>.
            </note>
        </ScriptParameter>

